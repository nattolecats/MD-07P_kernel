config DRM_PANEL_JD9161Z_BOE_WVGA_VDO_ISP
        tristate "BOE JD9161Z wvga vdo mode panel"
        depends on OF
        depends on DRM_MIPI_DSI
        depends on BACKLIGHT_CLASS_DEVICE
        help
                Say Y here if you want to enable support for himax
                vdo mode wvga panel. The panel has 480x800
                resolution and uses 24-bits RGB per pixel. It provides a
                MIPI DSI interface to host.

