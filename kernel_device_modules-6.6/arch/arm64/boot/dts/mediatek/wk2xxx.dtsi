&spi1 {
       #address-cells = <1>;
       #size-cells = <0>;
       wk2xxxspi@0 {
               compatible = "wkmic,wk2xxx_spi";//wk2124spi_cs0
               reg = <0>;
               spi-max-frequency = <1000000>;
               irq_gpio = <&pio 105 0>;
			   cs-gpios = <&pio 183 0>;
			   reset_gpio = <&pio 104 0>;
			   pwr_gpio = <&pio 190 0>;
               status = "okay";
       };
};
